{
  "realm": "twitterclone",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "clients": [
    {
      "clientId": "twitterclone-web",
      "name": "Twitter Clone Web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8081/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "twitterclone-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "twitterclone-dev",
      "name": "Local development (curl, password grant)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "twitterclone-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "6f1c2b9e-3d4a-4c8e-9b7f-2a5d8e1c0f31",
      "username": "clone",
      "enabled": true,
